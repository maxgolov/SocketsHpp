{
  "name": "socketshpp",
  "version": "1.0.0",
  "description": "Header-only C++ sockets library with HTTP/1.1 and MCP support",
  "homepage": "https://github.com/maxgolov/SocketsHpp",
  "license": "Apache-2.0",
  "supports": "!uwp",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    "nlohmann-json",
    "bshoshany-thread-pool"
  ],
  "features": {
    "jwt": {
      "description": "JWT bearer-token validation in the MCP server (jwt-cpp)",
      "dependencies": [
        "jwt-cpp"
      ]
    }
  }
}
